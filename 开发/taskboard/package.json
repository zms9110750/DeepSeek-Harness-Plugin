{
  "name": "@local/taskboard",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "任务板：一个包，六个插件",
  "exports": {
    ".": "./packages/core/index.js",
    "./core": "./packages/core/index.js",
    "./templates": "./packages/templates/index.js",
    "./plan-preset": "./packages/plan-preset/index.js",
    "./workspace": "./packages/workspace/index.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "packages",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
