{
  "name": "@local/taskboard2-core",
  "version": "0.1.0-a.0",
  "private": true,
  "type": "module",
  "description": "⑧ 核心：唯一编排入口。事务、顺序、对外门面。",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.host.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@local/taskboard2-store": "workspace:*",
    "@local/taskboard2-action": "workspace:*",
    "@local/taskboard2-types": "workspace:*",
    "@local/taskboard2-relation": "workspace:*",
    "@local/taskboard2-search": "workspace:*",
    "@local/taskboard2-workgroup": "workspace:*",
    "@local/taskboard2-taskcard": "workspace:*"
  },
  "engines": {
    "node": ">=22.15"
  }
}
