{
  "name": "@local/taskboard2-dsh-command",
  "version": "0.1.0-a.0",
  "private": true,
  "type": "module",
  "description": "⑪ dsh 斜杠命令：把核心能力包成 /task-*。只做适配，不做事。",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.host.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  }
}
